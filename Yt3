<body class="antialiased">

    <div class="max-w-7xl mx-auto px-4 py-6 md:py-10">
        <!-- HEADER -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div>
                <h1 class="text-3xl font-bold bg-gradient-to-r from-red-600 to-red-800 bg-clip-text text-transparent flex items-center gap-2">
                    <i class="fab fa-youtube text-red-600"></i> YouTube Automation Studio
                </h1>
                <p class="text-slate-500 mt-1">Batch upload | Schedule videos | Smart metadata automation</p>
            </div>
            <div id="authPanel" class="flex items-center gap-3 flex-wrap"></div>
        </div>

        <!-- CREDENTIALS CONFIG (Client ID required) -->
        <div id="configCard" class="bg-white rounded-2xl shadow-md border border-slate-200 p-5 mb-8 transition-smooth">
            <div class="flex flex-col md:flex-row gap-4 items-end">
                <div class="flex-1">
                    <label class="block text-sm font-semibold text-slate-700 mb-1"><i class="fas fa-key mr-1 text-amber-600"></i> Google OAuth 2.0 Client ID (Web)</label>
                    <input type="text" id="clientIdInput" class="w-full border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:ring-2 focus:ring-red-400 focus:border-red-400 outline-none" placeholder="Your Web Client ID (e.g., xxxxx.apps.googleusercontent.com)" />
                    <p class="text-xs text-slate-400 mt-1">Required: Enable YouTube Data API v3, create OAuth 2.0 Web client, set redirect URI to <code class="bg-slate-100 px-1 rounded">postmessage</code> or current origin.</p>
                </div>
                <div class="flex gap-2">
                    <button id="initGapiBtn" class="bg-slate-800 hover:bg-slate-900 text-white px-5 py-2.5 rounded-xl text-sm font-medium transition flex items-center gap-2"><i class="fas fa-plug"></i> Initialize &amp; Connect</button>
                    <button id="signOutBtn" class="bg-white border border-red-200 text-red-600 hover:bg-red-50 px-5 py-2.5 rounded-xl text-sm font-medium transition hidden items-center gap-2"><i class="fas fa-sign-out-alt"></i> Sign Out</button>
                </div>
            </div>
            <div id="authStatus" class="mt-3 text-sm text-slate-500"><i class="fas fa-circle text-slate-300 mr-1.5"></i> Not connected</div>
        </div>

        <!-- MAIN DASHBOARD (visible only after auth) -->
        <div id="dashboard" class="hidden space-y-8">
            <!-- TEMPLATE & AUTOMATION CONFIG -->
            <div class="bg-white rounded-2xl shadow-md border border-slate-200 p-5">
                <h2 class="text-xl font-bold text-slate-800 flex items-center gap-2"><i class="fas fa-robot text-indigo-500"></i> Automation Rules &amp; Template</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-4">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700">Title Pattern <span class="text-red-500">*</span></label>
                        <input type="text" id="titlePattern" class="w-full border rounded-lg px-3 py-2 text-sm" value="My Video {counter}" placeholder="{counter}, {date}, {filename}" />
                        <p class="text-xs text-slate-400 mt-1">Variables: {counter}, {date:YYYY-MM-DD}, {filename}</p>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700">Description Template</label>
                        <textarea id="descTemplate" rows="2" class="w-full border rounded-lg px-3 py-2 text-sm" placeholder="Auto-generated description...">🎬 Automated upload via YouTube Studio Tool
                    #YouTube #automation {date}</textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700">Default Tags (comma)</label>
                        <input type="text" id="defaultTags" class="w-full border rounded-lg px-3 py-2 text-sm" value="automation, tutorial, youtube" />
                        <label class="block text-sm font-semibold text-slate-700 mt-2">Category</label>
                        <select id="categoryId" class="w-full border rounded-lg px-3 py-2 text-sm">
                            <option value="22">People &amp; Blogs</option>
                            <option value="24">Entertainment</option>
                            <option value="28">Science &amp; Technology</option>
                            <option value="20">Gaming</option>
                            <option value="26">How-to &amp; Style</option>
                            <option value="10">Music</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-3">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700">Privacy Status</label>
                        <select id="privacyStatus" class="border rounded-lg px-3 py-2 text-sm w-full">
                            <option value="public">Public</option>
                            <option value="unlisted">Unlisted</option>
                            <option value="private" selected>Private</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700">Schedule Publish (ISO datetime) <span class="text-xs text-gray-400">optional</span></label>
                        <input type="datetime-local" id="scheduleTime" class="border rounded-lg px-3 py-2 text-sm w-full" />
                        <p class="text-xs text-amber-600 mt-1">If set, privacy will be forced to 'private' and video scheduled.</p>
                    </div>
                </div>
            </div>

            <!-- BATCH QUEUE MANAGER -->
            <div class="bg-white rounded-2xl shadow-md border border-slate-200 p-5">
                <div class="flex flex-wrap justify-between items-center mb-4 gap-3">
                    <h2 class="text-xl font-bold flex items-center gap-2"><i class="fas fa-layer-group text-blue-600"></i> Batch Upload Queue</h2>
                    <div class="flex gap-2 flex-wrap">
                        <label class="bg-slate-100 hover:bg-slate-200 rounded-xl px-4 py-2 cursor-pointer text-sm font-medium transition flex items-center gap-2">
                            <i class="fas fa-plus-circle text-green-600"></i> Add Videos
                            <input type="file" id="videoFileInput" multiple accept="video/*" class="hidden" />
                        </label>
                        <button id="clearQueueBtn" class="bg-white border border-red-200 text-red-600 hover:bg-red-50 rounded-xl px-4 py-2 text-sm font-medium transition"><i class="fas fa-trash-alt"></i> Clear</button>
                        <button id="startBatchUpload" class="bg-red-600 hover:bg-red-700 text-white rounded-xl px-5 py-2 text-sm font-medium shadow-sm transition flex items-center gap-2"><i class="fas fa-play-circle"></i> Start Automation (Batch Upload)</button>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm">
                        <thead class="bg-slate-50 text-slate-700 border-b">
                            <tr>
                                <th class="px-4 py-2 text-left">File name</th>
                                <th class="px-4 py-2 text-left">Title (editable)</th>
                                <th class="px-4 py-2 text-left">Status</th>
                                <th class="px-4 py-2 text-center w-24">Action</th>
                            </tr>
                        </thead>
                        <tbody id="queueTableBody">
                            <tr class="text-center text-slate-400"><td colspan="4">No videos in queue. Add videos to start automation.</td></tr>
                        </tbody>
                    </table>
                </div>
                <div id="globalProgress" class="mt-4 hidden">
                    <div class="flex justify-between text-xs text-slate-600 mb-1"><span id="progressLabel">Upload progress</span><span id="progressPercent">0%</span></div>
                    <div class="w-full bg-slate-200 rounded-full h-2.5"><div id="uploadProgressFill" class="bg-red-500 h-2.5 rounded-full transition-all duration-300" style="width:0%"></div></div>
                </div>
            </div>

            <!-- ADDITIONAL UTILITIES: FETCH VIDEOS & BULK UPDATE -->
            <div class="bg-white rounded-2xl shadow-md border border-slate-200 p-5">
                <h2 class="text-xl font-bold flex items-center gap-2"><i class="fas fa-video text-purple-600"></i> Existing Videos Manager (Bulk Update)</h2>
                <div class="flex flex-wrap gap-3 mt-3">
                    <button id="fetchVideosBtn" class="bg-slate-700 hover:bg-slate-800 text-white px-4 py-2 rounded-xl text-sm"><i class="fas fa-sync-alt"></i> Fetch latest 10 videos</button>
                    <button id="bulkAppendDescBtn" class="bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-xl text-sm disabled:opacity-50" disabled><i class="fas fa-tags"></i> Append &quot;#AutoUpdated&quot; to selected</button>
                    <span class="text-xs text-slate-400 self-center">Select videos below to mass edit description</span>
                </div>
                <div id="videoListContainer" class="mt-4 max-h-72 overflow-y-auto border rounded-xl p-2 bg-slate-50"></div>
            </div>
        </div>

        <!-- TOAST -->
        <div id="toastMsg" class="fixed bottom-5 right-5 z-50 hidden bg-slate-800 text-white px-5 py-3 rounded-xl shadow-lg text-sm max-w-sm"></div>
    </div>

    <!-- Google APIs -->
    <script src="https://apis.google.com/js/api.js">
    </script>

    <script>
        // ============================================================
        //  GLOBALS
        // ============================================================
        let accessToken = null;
        let tokenClient = null;
        let gapiInited = false;
        let gisInited = false;
        let currentUser = null; // { name, email, picture }

        const queue = []; // { id, file, customTitle, status, progress, videoId, error }
        let nextCounter = 1;
        let uploadingActive = false;
        let fetchedVideos = []; // array of video objects from API
        let selectedVideoIds = new Set();

        // DOM refs
        const $ = id => document.getElementById(id);
        const dashboard = $('dashboard');
        const authPanel = $('authPanel');
        const authStatus = $('authStatus');
        const clientIdInput = $('clientIdInput');
        const initBtn = $('initGapiBtn');
        const signOutBtn = $('signOutBtn');
        const videoFileInput = $('videoFileInput');
        const queueBody = $('queueTableBody');
        const clearQueueBtn = $('clearQueueBtn');
        const startBatchBtn = $('startBatchUpload');
        const globalProgressDiv = $('globalProgress');
        const progressFill = $('uploadProgressFill');
        const progressPercentSpan = $('progressPercent');
        const progressLabel = $('progressLabel');
        const fetchVideosBtn = $('fetchVideosBtn');
        const bulkAppendBtn = $('bulkAppendDescBtn');
        const videoListContainer = $('videoListContainer');
        const toastMsg = $('toastMsg');

        const titlePatternInput = $('titlePattern');
        const descTemplate = $('descTemplate');
        const defaultTags = $('defaultTags');
        const categoryId = $('categoryId');
        const privacyStatus = $('privacyStatus');
        const scheduleTime = $('scheduleTime');

        // ============================================================
        //  TOAST
        // ============================================================
        function showToast(msg, isError = false, duration = 4500) {
            toastMsg.innerText = msg;
            toastMsg.className =
                `fixed bottom-5 right-5 z-50 px-5 py-3 rounded-xl shadow-lg text-sm max-w-sm transition-all duration-300 ${isError ? 'bg-red-600' : 'bg-slate-800'} text-white`;
            toastMsg.classList.remove('hidden');
            clearTimeout(toastMsg._timer);
            toastMsg._timer = setTimeout(() => toastMsg.classList.add('hidden'), duration);
        }

        // ============================================================
        //  QUEUE RENDER
        // ============================================================
        function renderQueue() {
            if (!queue.length) {
                queueBody.innerHTML =
                    `<tr class="text-center text-slate-400"><td colspan="4">No videos in queue. Add videos to start automation.</td></tr>`;
                return;
            }
            let html = '';
            queue.forEach((item, idx) => {
                const statusMap = {
                    pending: 'bg-gray-200 text-gray-700',
                    uploading: 'bg-blue-100 text-blue-700',
                    success: 'bg-green-100 text-green-700',
                    error: 'bg-red-100 text-red-700'
                };
                const cls = statusMap[item.status] || statusMap.pending;
                html += `<tr class="border-b border-slate-100 hover:bg-slate-50">
                            <td class="px-4 py-2 max-w-[180px] truncate" title="${escapeHtml(item.file.name)}">${escapeHtml(item.file.name)}</td>
                            <td class="px-4 py-2">
                                <input type="text" class="border rounded-md w-full px-2 py-1 text-sm queue-title-input" data-idx="${idx}" value="${escapeHtml(item.customTitle || '')}" ${item.status === 'uploading' || item.status === 'success' ? 'disabled' : ''}>
                            </td>
                            <td class="px-4 py-2 text-xs"><span class="px-2 py-0.5 rounded-full ${cls} status-badge">${item.status || 'pending'}</span></td>
                            <td class="px-4 py-2 text-center">
                                ${item.status === 'success' ? `<a href="https://youtu.be/${item.videoId}" target="_blank" class="text-blue-500 hover:text-blue-700" title="View on YouTube"><i class="fas fa-external-link-alt"></i></a>` :
                                  `<button class="removeQueueBtn text-red-500 hover:text-red-700" data-idx="${idx}" ${item.status === 'uploading' ? 'disabled' : ''}><i class="fas fa-times-circle"></i></button>`}
                            </td>
                        </tr>`;
            });
            queueBody.innerHTML = html;

            // Sync title inputs
            document.querySelectorAll('.queue-title-input').forEach(inp => {
                const idx = parseInt(inp.dataset.idx);
                inp.addEventListener('change', () => {
                    if (queue[idx] && queue[idx].status !== 'uploading' && queue[idx].status !== 'success') {
                        queue[idx].customTitle = inp.value;
                    }
                });
            });
            document.querySelectorAll('.removeQueueBtn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const idx = parseInt(btn.dataset.idx);
                    if (queue[idx] && queue[idx].status === 'uploading') return;
                    queue.splice(idx, 1);
                    renderQueue();
                });
            });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/[&<>]/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' } [m] || m));
        }

        // ============================================================
        //  ADD FILES TO QUEUE
        // ============================================================
        function addFilesToQueue(files) {
            const pattern = titlePatternInput.value || 'Video {counter}';
            let counter = queue.length + 1;
            for (const file of files) {
                const rawName = file.name.replace(/\.[^/.]+$/, '') || 'video';
                const dateNow = new Date().toISOString().slice(0, 10);
                let title = pattern
                    .replace(/{counter}/g, counter++)
                    .replace(/{date}/g, dateNow)
                    .replace(/{filename}/g, rawName);
                queue.push({
                    id: Date.now() + Math.random() * 1000 + queue.length,
                    file: file,
                    customTitle: title,
                    status: 'pending',
                    progress: 0,
                    videoId: null,
                    error: null
                });
            }
            renderQueue();
            showToast(`${files.length} video(s) added to queue.`);
        }

        // ============================================================
        //  AUTH – Google Identity Services
        // ============================================================
        function initAuth() {
            const clientId = clientIdInput.value.trim();
            if (!clientId) {
                showToast('Please enter your Google OAuth 2.0 Client ID.', true);
                return;
            }
            if (!clientId.includes('.apps.googleusercontent.com')) {
                showToast('Invalid Client ID format. Should end with .apps.googleusercontent.com', true);
                return;
            }

            try {
                tokenClient = google.accounts.oauth2.initTokenClient({
                    client_id: clientId,
                    scope: 'https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly',
                    callback: (response) => {
                        if (response.error) {
                            showToast('Auth error: ' + response.error, true);
                            return;
                        }
                        accessToken = response.access_token;
                        fetchUserInfo();
                    },
                });
      
